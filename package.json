{
  "name": "playable-template-phaser",
  "version": "1.0.0",
  "description": "A starter template for creating playable ads using Phaser and @smoud/playable-sdk with TypeScript support",
  "scripts": {
    "dev": "playable-scripts dev",
    "build": "playable-scripts build",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit --ignoreDeprecations 5.0"
  },
  "keywords": [
    "playable",
    "ads",
    "template",
    "phaser",
    "webgl",
    "2d",
    "typescript",
    "game"
  ],
  "author": "Smoud",
  "dependencies": {
    "@smoud/playable-sdk": "^1.0.24",
    "phaser": "^3.90.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@smoud/playable-scripts": "^1.1.4",
    "@types/three": "^0.185.1",
    "prettier": "^2.7.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
